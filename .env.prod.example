# Copy this file to `.env` at the repo root before running
# docker-compose.prod.yml (`cp .env.prod.example .env`, then fill in
# every value below). `.env` is gitignored — never commit it.
#
# See docs/deployment.md for the full runbook: where each value comes
# from, DNS/firewall prerequisites, and first-time setup order.

# --- PostgreSQL (ADR 0003/0006) ---
POSTGRES_USER=isd
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=
POSTGRES_DB=isd_api

# --- API ---
# Generate with: openssl rand -base64 48
# The app refuses to start in production without a real value here
# (Settings.require_production_ready(), services/api/src/isd_api/config.py).
ISD_API_JWT_SECRET_KEY=

# The public web origin, as a JSON list (must match what the browser
# actually sees — see docs/deployment.md for why this stays required
# even though the Caddyfile below happens to make api/web same-origin).
ISD_API_CORS_ALLOWED_ORIGINS=["https://bus.yourdistrict.example.org"]

# Optional: OpenRouteService API key (spec section 6/8) for real
# road-network deadhead times and district avoid-zones. Leave blank to
# use the straight-line fallback estimator.
ISD_API_ORS_API_KEY=

# --- Web ---
# The public origin the browser reaches the api at, via Caddy's
# /api/* path routing (see ./Caddyfile) — same domain as CADDY_DOMAIN
# below, with an /api suffix.
PUBLIC_API_ORIGIN=https://bus.yourdistrict.example.org/api

# --- Caddy (automatic HTTPS) ---
# DNS A/AAAA record for this must already point at this host before
# `docker compose up` — see docs/deployment.md.
CADDY_DOMAIN=bus.yourdistrict.example.org
