# Copy this file to `.env` at the repo root before running
# docker-compose.prod.yml (`cp .env.prod.example .env`, then fill in
# every value below). `.env` is gitignored — never commit it.
#
# See docs/deployment.md for the full runbook: where each value comes
# from, DNS/firewall prerequisites, and first-time setup order.

# --- PostgreSQL (ADR 0003/0006) ---
# The password itself is NOT set here — it's a Docker secret file.
# First run: secrets/README.md (openssl rand -base64 32 > secrets/postgres_password.txt).
POSTGRES_USER=isd
POSTGRES_DB=isd_api

# --- API ---
# Format: postgresql+psycopg://<POSTGRES_USER>:<the password from
# secrets/postgres_password.txt, exactly>@postgres:5432/<POSTGRES_DB>
# psycopg (v3) — the +psycopg scheme is required (see pyproject.toml's
# `postgres` extra); plain postgresql:// resolves to psycopg2, which
# isn't installed. Left blank here on purpose (see docs/deployment.md
# step 4) rather than filled with a placeholder that looks like a real
# connection string.
ISD_API_DATABASE_URL=

# Generate with: openssl rand -base64 48
# The app refuses to start in production without a real value here
# (Settings.require_production_ready(), services/api/src/isd_api/config.py).
ISD_API_JWT_SECRET_KEY=

# The public web origin, as a JSON list (must match what the browser
# actually sees — see docs/deployment.md for why this stays required
# even though the Caddyfile below happens to make api/web same-origin).
ISD_API_CORS_ALLOWED_ORIGINS=["https://bus.yourdistrict.example.org"]

# Optional: OpenRouteService API key (spec section 6/8) for real
# road-network deadhead times and district avoid-zones. Leave blank to
# use the straight-line fallback estimator.
ISD_API_ORS_API_KEY=

# The routing engine (docs/routing-engine.md). Leave these out to use the
# demo district's map; a real district puts its region's .osm.pbf in ./maps.
# ROUTING_MAP_FILE=/maps/texas-latest.osm.pbf
# ROUTING_JAVA_OPTS=-Xms1g -Xmx8g
# Blank turns the engine off (OpenRouteService or straight lines instead).
# ISD_API_ROUTING_ENGINE_URL=

# Days of GPS history to keep (bus tracks and the positions report).
# Older points are deleted automatically. See ADR 0009's addendum.
ISD_API_POSITION_HISTORY_DAYS=30

# Passwords (optional; these are the defaults). The minimum applies to
# new and changed passwords; admin-issued reset links work once, for
# this many hours.
# ISD_API_PASSWORD_MIN_LENGTH=8
# ISD_API_PASSWORD_RESET_LINK_HOURS=24

# Scheduled SIS roster sync (optional; docs/deployment.md, "SIS sync"):
# the district's OneRoster 1.1 REST API and its OAuth 2 token endpoint,
# from the SIS vendor or a hub such as ClassLink. All four set = a nightly
# sync at ISD_API_SIS_SYNC_TIME and "Sync now" on Setup > SIS import.
ISD_API_SIS_ONEROSTER_BASE_URL=
ISD_API_SIS_ONEROSTER_TOKEN_URL=
ISD_API_SIS_ONEROSTER_CLIENT_ID=
ISD_API_SIS_ONEROSTER_CLIENT_SECRET=
# ISD_API_SIS_ONEROSTER_SCOPE=
# ISD_API_SIS_SYNC_TIME=03:00

# Single sign-on (optional; docs/deployment.md, "Single sign-on").
# Blank issuer = no "Sign in with your district account" button.
ISD_API_OIDC_ISSUER=
ISD_API_OIDC_CLIENT_ID=
ISD_API_OIDC_CLIENT_SECRET=
ISD_API_OIDC_REDIRECT_URI=https://bus.yourdistrict.example.org/api/auth/oidc/callback
# claim (default) | always | never: when the district's MFA replaces ours.
# ISD_API_OIDC_TRUST_MFA=claim
# ISD_API_OIDC_LABEL=your district account

# Backups (required; docs/deployment.md, "Backups"). Where the encrypted
# nightly backups go, off this server: any restic repository, e.g.
#   s3:https://s3.us-west-004.backblazeb2.com/your-bucket/isd   (Backblaze B2)
#   s3:https://<account>.r2.cloudflarestorage.com/your-bucket    (Cloudflare R2)
#   s3:https://s3.amazonaws.com/your-bucket                      (AWS S3)
# The password that encrypts them is ./secrets/restic_password.txt; keep a
# copy in a password manager, off this server.
RESTIC_REPOSITORY=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_TIME=02:00
# BACKUP_TZ=America/Chicago

# The interactive API docs (/api/docs) are hidden in production; set to
# true only if you need them, e.g. while integrating another system.
# ISD_API_EXPOSE_API_DOCS=false

# Two-step sign-in (required). Encrypts each person's authenticator
# secret; changing it later means everyone sets theirs up again. Generate:
#   python -c "import base64,secrets;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
ISD_API_MFA_ENCRYPTION_KEY=
# Roles that must use an authenticator app (JSON list). Drivers never do.
# ISD_API_MFA_REQUIRED_ROLES=["transportation_admin","dispatcher"]

# Email (optional; docs/deployment.md, "Email"). Any SMTP provider:
# Amazon SES, Postmark, Brevo, Google Workspace, your district's server.
# Leave ISD_API_SMTP_HOST blank for no email ("Forgot password" is then
# hidden and admins hand out reset links themselves).
ISD_API_SMTP_HOST=
# 587 with starttls (most providers) or 465 with ssl.
ISD_API_SMTP_PORT=587
ISD_API_SMTP_SECURITY=starttls
ISD_API_SMTP_USERNAME=
ISD_API_SMTP_PASSWORD=
# Required when ISD_API_SMTP_HOST is set; must be an address your
# provider lets you send from (SPF/DKIM set up for its domain).
ISD_API_MAIL_FROM="Transportation Office <transportation@yourdistrict.example.org>"
# Where links in emails point. Blank = the first CORS origin above.
ISD_API_PUBLIC_WEB_URL=
# ISD_API_PASSWORD_RESET_EMAIL_MINUTES=60
# ISD_API_ACCOUNT_SETUP_LINK_HOURS=72

# --- Web ---
# The public origin the browser reaches the api at, via Caddy's
# /api/* path routing (see ./Caddyfile) — same domain as CADDY_DOMAIN
# below, with an /api suffix.
PUBLIC_API_ORIGIN=https://bus.yourdistrict.example.org/api

# Optional: map tiles for the fleet, family and stops maps. Blank uses
# OpenStreetMap's public tile servers, which are fine for a pilot but
# see which area each viewer looks at. For go-live, point this at a
# provider the district has an agreement with, or a self-hosted tile
# server, e.g. https://tiles.yourdistrict.example.org/{z}/{x}/{y}.png,
# and set the attribution that provider requires (HTML allowed).
MAP_TILE_URL=
MAP_ATTRIBUTION=

# --- Caddy (automatic HTTPS) ---
# DNS A/AAAA record for this must already point at this host before
# `docker compose up` — see docs/deployment.md.
CADDY_DOMAIN=bus.yourdistrict.example.org
